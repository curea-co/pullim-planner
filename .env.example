# pullim-api(통합 IdP + planner 도메인) base — 세션(쿠키 SSO + CSRF)·planner 데이터 모두 여기로.
#   · 로그인/세션: auth-context → pullimSession (lib/auth/pullim-session-client.ts)
#   · planner 데이터(/planner/*): lib/planner/client → pullim-client
# prefix 없음. 미설정 시 http://localhost:3000.
#   local(SSO): http://api.pullim.local:3000   (FE 는 planner.pullim.local:3006 — same-site 쿠키)
#   dev:        https://dev-api.pullim.ai      (FE 는 dev-planner.pullim.ai)
#   prod:       https://api.pullim.ai          (FE 는 planner.pullim.ai)
# ⚠️ localhost 로 두면 *.pullim.local 접속 시 cross-site 라 로그인 후 /planner/me 가 계속 비인증 —
#    LOGIN_URL(아래)과 같은 등록도메인으로 함께 맞출 것.
NEXT_PUBLIC_PULLIM_API_URL=http://api.pullim.local:3000
# non-HttpOnly CSRF 쿠키 이름(env별). local=local-pullim-csrf / dev=dev-pullim-csrf / prod=prod-pullim-csrf.
NEXT_PUBLIC_PULLIM_CSRF_COOKIE=local-pullim-csrf

# 중앙 로그인 base — 미인증 시 ${LOGIN}/login?next= 로 위임(SSO). 게이트키퍼 확정: pullim.ai/login(apex).
# ⚠️ 환경별 필수(코드 기본값 없음 — 미설정 시 명시적 실패). 호스트는 *.pullim.local/apex(localhost 금지·쿠키 공유).
#   local: http://pullim.local:3001  /  dev: 배포 env  /  prod: https://pullim.ai
NEXT_PUBLIC_PULLIM_LOGIN_URL=http://pullim.local:3001

# 공통 헤더(서비스 전환) 비-플래너 서비스 호스트(OS). local: http://os.pullim.local:3001 / prod: https://os.pullim.ai
NEXT_PUBLIC_PULLIM_OS_URL=http://os.pullim.local:3001

# 로컬 dev 전용 — 인증 게이트 우회(mock 렌더). next dev + localhost 계열 호스트에서만 동작(3중 가드).
# 실 SSO 검증 시 0. 절차: proc/2026-06-29_planner-local-sso-setup.md
NEXT_PUBLIC_DEV_AUTH_BYPASS=1

# 루틴 기능 플래그
NEXT_PUBLIC_ROUTINE_ENABLED=1
