# Local Postgres (Docker — docker-compose.yml)
DATABASE_URL=postgres://pullim:pullim_local@localhost:5432/pullim_planner

# 1차 mock auth — 실 도입 전까지 단일 사용자
NEXT_PUBLIC_DEFAULT_USER_ID=student_001

# 자체 NestJS BE base (글로벌 prefix /api). 흡수 §10 cutover 후 **가입/이메일확인 한시적 용도만**
# (auth-context.signup/checkEmail). planner 데이터·로그인/세션은 pullim-api 로 이관됨(아래). 폐기 예정.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4030/api

# pullim-api(통합 IdP + 흡수형 planner) base — 흡수 전환 §10 cutover.
#   · 로그인/세션(쿠키 SSO + CSRF): auth-context → pullimSession
#   · planner 도메인 데이터(/planner/*): @/lib/planner/client → pullim-client
# prefix 없음(자체 BE 와 분리). 미설정 시 http://localhost:3000.
#   dev:  https://dev-api.pullim.ai   (FE 는 dev-planner.pullim.ai 에서 서빙 — same-site 쿠키)
#   prod: https://api.pullim.ai       (FE 는 planner.pullim.ai)
# ⚠️ 로컬 SSO(아래 LOGIN_URL=pullim.local) 사용 시 이 값도 http://api.pullim.local:3000 으로 — 같은 등록도메인이어야
#    same-site 쿠키 공유(localhost 면 로그인 후 /planner/me 가 계속 비인증). 두 env 를 함께 바꿀 것.
NEXT_PUBLIC_PULLIM_API_URL=http://localhost:3000
# non-HttpOnly CSRF 쿠키 이름(env별). dev=dev-pullim-csrf / prod=prod-pullim-csrf.
NEXT_PUBLIC_PULLIM_CSRF_COOKIE=local-pullim-csrf

# 중앙 로그인 base — 미인증 시 ${LOGIN}/login?next= 로 위임(SSO). 게이트키퍼 확정: pullim.ai/login(apex).
# ⚠️ 환경별 필수(코드 기본값 없음 — 미설정 시 명시적 실패). 호스트는 *.pullim.local/apex(localhost 금지·쿠키 공유).
#   local: http://pullim.local:3001  /  dev: 배포 env  /  prod: https://pullim.ai
NEXT_PUBLIC_PULLIM_LOGIN_URL=http://pullim.local:3001
