# Local Postgres (Docker — docker-compose.yml)
DATABASE_URL=postgres://pullim:pullim_local@localhost:5432/pullim_planner

# 1차 mock auth — 실 도입 전까지 단일 사용자
NEXT_PUBLIC_DEFAULT_USER_ID=student_001

# BE API base (NestJS, 글로벌 prefix /api 포함). 미설정 시 http://localhost:4030/api 기본값.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4030/api
