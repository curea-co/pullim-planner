PORT=4030

# ── Database ───────────────────────────────────────────────────────────────
# Phase β 스모크(common 인프라만)는 DATABASE_ENABLED=false 로 DB 없이 부팅된다.
# auth(Phase 0~) 동작에는 실DB 가 필요하므로 true + 아래 값 설정.
# DATABASE_ENABLED=true
# DATABASE_URL=postgres://pullim:pullim_local@localhost:5432/pullim_planner
# auth 는 정식 마이그레이션으로 스키마를 소유하므로 synchronize 는 끈다
# (Drizzle 시대 도메인 테이블을 TypeORM 이 건드리지 못하게).
# DATABASE_SYNCHRONIZE=false

# ── Auth / JWT (Phase 0) ─────────────────────────────────────────────────────
# 로컬에서는 임의의 충분히 긴 문자열이면 된다. 운영은 시크릿 매니저로 주입.
# JWT_SECRET=local-dev-jwt-secret-change-me
# PASSWORD_PEPPER=local-dev-password-pepper-change-me
# Access/Refresh 토큰 만료(초). 미설정 시 3600 / 604800(7일).
# JWT_EXPIRATION=3600
# JWT_REFRESH_EXPIRATION=604800
